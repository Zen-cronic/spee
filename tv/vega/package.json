{
  "name": "@amazon-devices/speakingmirror",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf node_modules buildinfo.json dist build",
    "start": "react-native start",
    "test": "jest --colors",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test package.json --ext .ts,.tsx",
    "build:release": "react-native build-vega --build-type Release",
    "build:debug": "react-native build-vega --build-type Debug",
    "build": "npm-run-all build:release",
    "hub": "node -e \"require('fs').writeFileSync('src/hub.json', JSON.stringify({hostport: process.argv[1]}) + '\\\\n')\""
  },
  "dependencies": {
    "@amazon-devices/react-native-kepler": "~4.0.0",
    "react": "19.2.0",
    "react-native": "0.83.0",
    "tv-voice-bridge": "file:../../vendor/tv-voice-bridge-0.3.0.tgz"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@amazon-devices/eslint-plugin-kepler": "^0.1.4",
    "@amazon-devices/kepler-cli-platform": "^0",
    "@react-native-community/cli": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@react-native/typescript-config": "0.83.0",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jest": "^27.6.0",
    "jest": "^29.7.0",
    "jsonc-eslint-parser": "^2.4.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "react-test-renderer": "19.2.0",
    "ts-jest": "^29.2.5",
    "typescript": "5.8.3"
  },
  "kepler": {
    "projectType": "application",
    "appName": "speakingmirror",
    "targets": [
      "tv"
    ]
  }
}
