{
  "name": "spee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup": "npm install && npm --prefix tv/web install",
    "demo": "npm run web:build && npm run tv:web:build && tsx src/hub/server.ts --demo",
    "fixtures": "tsx scripts/build-fixtures.ts",
    "poc": "tsx src/poc.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/phone && tsc --noEmit -p web/sim && tsc --noEmit -p tv/web",
    "real": "tsx scripts/real.ts",
    "class": "tsx scripts/class.ts",
    "day1": "tsx scripts/score-day1.ts",
    "mislabel:score": "tsx scripts/score-mislabel.ts",
    "review": "tsx scripts/review.ts",
    "meetings": "tsx scripts/meetings.ts",
    "meetings:score": "tsx scripts/score-meetings.ts",
    "instrument:check": "tsx scripts/instrument-check.ts",
    "leak-check": "tsx scripts/leak-check.ts",
    "hub": "tsx src/hub/server.ts",
    "contract:check": "tsx scripts/contract-check.ts",
    "demo:fixtures": "tsx scripts/build-demo-fixtures.ts",
    "hub:cards": "tsx scripts/hub-cards.ts",
    "contract:fixtures": "tsx scripts/contract-v2-examples.ts",
    "tv:web:dev": "npm --prefix tv/web run dev",
    "tv:web:build": "npm --prefix tv/web run build",
    "tv:vega:build": "npm --prefix tv/vega run build",
    "tv:sync": "tsx scripts/tv-sync.ts",
    "web:phone:build": "vite build --config web/phone/vite.config.ts",
    "web:sim:build": "vite build --config web/sim/vite.config.ts",
    "web:build": "npm run web:phone:build && npm run web:sim:build",
    "alexa:deploy": "tsx scripts/alexa-deploy.ts",
    "alexa:apl:preview": "tsx scripts/apl-preview.ts",
    "wrist:probe": "tsx scripts/wrist-probe.ts",
    "demo:replay": "tsx scripts/demo-replay.ts",
    "check": "npm run typecheck && npm test && npm run contract:check && npm run leak-check",
    "tv:stick:open": "vega device launch-app -d ${STICK:?set STICK=<stick IP>:5555} --appName com.beecoach.mirror.main"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1151.0",
    "@aws-sdk/credential-providers": "^3.1151.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "tv-voice-bridge": "file:vendor/tv-voice-bridge-0.3.5.tgz",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "vitest": "^5.0.4"
  }
}
